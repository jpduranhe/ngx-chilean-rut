{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ngx-chilean-rut": {
      "projectType": "library",
      "root": "projects/ngx-chilean-rut",
      "sourceRoot": "projects/ngx-chilean-rut/src",
      "prefix": "ngx",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/ngx-chilean-rut/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-chilean-rut/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-chilean-rut/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-chilean-rut/tsconfig.spec.json",
            "runner": "vitest"
          },
          "configurations": {
            "coverage": {
              "coverage": true,
              "coverageReporters": [
                "text-summary",
                "lcovonly"
              ],
              "coverageExclude": [
                "**/*.spec.ts"
              ],
              "coverageThresholds": {
                "statements": 95,
                "branches": 90,
                "functions": 95,
                "lines": 95
              }
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ngx-chilean-rut/**/*.ts",
              "projects/ngx-chilean-rut/**/*.html"
            ],
            "eslintConfig": "projects/ngx-chilean-rut/eslint.config.js"
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": [
      "angular-eslint"
    ]
  }
}
